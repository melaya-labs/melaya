{
    "name": "melaya/sdk",
    "description": "Official SDK for Melaya Agent Builder and Mobile Device Control. Includes preview Melaya Trading namespaces that are not yet generally available.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["melaya", "ai-agents", "device-control", "agent-builder", "sdk", "trading", "market-data", "websocket"],
    "homepage": "https://melaya.org",
    "support": {
        "source": "https://github.com/melaya-labs/melaya",
        "issues": "https://github.com/melaya-labs/melaya/issues",
        "docs": "https://melaya.org/documentation"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Melaya\\": "packages/sdk-php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Melaya\\Tests\\": "packages/sdk-php/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
