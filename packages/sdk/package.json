{
  "name": "@melaya/sdk",
  "version": "0.2.0",
  "description": "Official SDK for Melaya Agent Builder and Mobile Device Control. Includes preview Melaya Trading namespaces that are not yet generally available.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "melaya",
    "ai-agents",
    "device-control",
    "agent-builder",
    "agentic-ai",
    "mobile-agents",
    "human-in-the-loop",
    "sdk",
    "trading",
    "market-data",
    "websocket"
  ],
  "homepage": "https://melaya.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/melaya-labs/melaya.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/melaya-labs/melaya/issues"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
